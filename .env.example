# 复制成 .env 后填自己的 key。.env 已在 .gitignore 里，不会进 git。
# 一个渠道一把 key，代理只读取它需要的那些；缺 key 的渠道会被自动跳过。

# ── 国内直连（不需要海外网络）────────────────────────────
SILICONFLOW_API_KEY=
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=

# ── 需要海外网络 ─────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GITHUB_MODELS_TOKEN=

# ── 本地兜底（Ollama，不需要 key）────────────────────────
# Ollama 服务地址，装好后保持默认即可
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
